  statusOperacional         StatusOperacional?
  dataInicioTeste           DateTime?
  dataUltimaAtualizacaoDados DateTime?
  domainUsed                String?
  nextReviewAt              DateTime?
  moeda                     String?

  // Rollups (somente leitura via API)
  gastoTotalAcumulado       Decimal?             @db.Decimal(14, 2)
  receitaConfirmadaAcumulada Decimal?            @db.Decimal(14, 2)
  roiReal                   Decimal?             @db.Decimal(10, 4)
  cpaReal                   Decimal?             @db.Decimal(10, 2)

  contas    ContaTrafegoProduto[]
  vendas    VendaAfiliado[]
  campanhas Campanha[]
  termos    Termo[]
}

enum PlataformaAfiliado {
  BRAIP
  MONETIZZE
  HOTMART
  EDUZZ
  CLICKBANK
  BUYGOODS
  MAXWEB
  GROWMEDIA
  MEDIASCALERS
  GURUMEDIA
  DIGISTORE24
  SMARTADV
  CARTPANDA
  ADCOMBO
  OUTRO
}

enum StatusProdutoAfiliado {
  ATIVO
  PAUSADO
  ARQUIVADO
}

model ContaTrafegoProduto {
  id             String         @id @default(cuid())
  contaTrafegoId String
  contaTrafego   ContaTrafego   @relation(fields: [contaTrafegoId], references: [id], onDelete: Cascade)
  produtoId      String
  produto        ProdutoAfiliado @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  linkTracking   String?
  ativo          Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([contaTrafegoId, produtoId])
  @@index([contaTrafegoId])
  @@index([produtoId])
}

model VendaAfiliado {
  id               String              @id @default(cuid())
  contaTrafegoId   String
  contaTrafego     ContaTrafego        @relation(fields: [contaTrafegoId], references: [id], onDelete: Cascade)
  produtoId        String?
  produto          ProdutoAfiliado?    @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  campanhaId       String?             // subid = Campanha.id (afiliados-ingestao / vendas-comissoes-afiliados)
  campanha         Campanha?           @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  data             DateTime
  valorVenda       Decimal             @db.Decimal(12, 2)
  valorComissao    Decimal             @db.Decimal(12, 2)
  plataformaAfil   PlataformaAfiliado
  status           StatusVendaAfiliado @default(PENDENTE)
  origem           OrigemVendaAfiliado @default(MANUAL)
  externalId       String?
  tipoIdentificador String?            // ex.: GCLID, ORDER_ID — substitui suposição fixa de gclid
  valorIdentificador String?
  orderId          String?
  statusUploadAds  StatusUploadAds     @default(PENDENTE)
  observacoes      String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([contaTrafegoId, data])
  @@index([status])
  @@index([campanhaId])
  @@unique([plataformaAfil, externalId])
}

enum StatusVendaAfiliado {
  PENDENTE
  APROVADA
  CANCELADA
  ESTORNADA
}

enum OrigemVendaAfiliado {
  MANUAL
  WEBHOOK
  IMPORT
}

// ─── RADAR & DECISÃO DE OFERTAS ──────────────────────────────────────────────

enum StatusDecisaoOferta {
  GARIMPO
  ANALISE
  APROVADO_TESTE
  EM_EXECUCAO
  PAUSADO
  DESCARTADO
}

enum CompletudeDados {
  COMPLETO
  PARCIAL
  INCOMPLETO
}

enum ReputationStatus {
  ok
  flagged
  burned
}

enum ConversionPoint {
  SALE
  VALID_CC_SUBMIT
  LEAD
  CALL
}

enum TipoProdutoAfiliado {
  NUTRACEUTICO_TRIAL
  ECOM
  INFOPRODUTO
  SERVICO
}

enum SaturacaoAfiliados {
  BAIXA
  MEDIA
  ALTA
  DESCONHECIDA
}

enum EstrategiaCampanha {
  REVIEW_BOTTOM_FUNNEL
  GENERIC_TOP_FUNNEL
  BRANDED_BIDDING
}

enum StatusOperacional {
  TESTANDO
  ESCALANDO
  PAUSADO
  ENCERRADO
}

enum PapelContaAds {
  PRINCIPAL
  CONTINGENCIA
}

model OfertaDecisao {
  id                    String              @id @default(cuid())
  nome                  String              @unique
  plataformas           String[]
  vertical              String?
  geoPrioritario        String?
  geosPermitidos        String[]

  // Economics da Rede (do CSV ou Manual)
  visitasTotais         Int?
  tendenciaTrafego30d   Decimal?            @db.Decimal(8, 2)
  tendenciaTrafego60d   Decimal?            @db.Decimal(8, 2)
  tendenciaTrafego90d   Decimal?            @db.Decimal(8, 2)
  statusTendencia       String?
  comissaoValor         Decimal?            @db.Decimal(10, 2)
  epcRede               Decimal?            @db.Decimal(8, 2)
  cvrRede               Decimal?            @db.Decimal(5, 2)
  refundPct             Decimal?            @db.Decimal(5, 2)
  bounceRate            Decimal?            @db.Decimal(5, 2)
  cbGravity             Decimal?            @db.Decimal(8, 2)
  cbScore               Decimal?            @db.Decimal(8, 2)

  // Leilão / Google Ads (Pesquisa adicional)
  cpcMinimo             Decimal?            @db.Decimal(8, 2)
  cpcMaximo             Decimal?            @db.Decimal(8, 2)
  cpcMedioEsperado      Decimal?            @db.Decimal(8, 2)
  volumeBuscaMensal     Int?
  brandBiddingPermitido Boolean             @default(true)
  keywordsPrioritarias  String[]

  // Governança & Decisão
  scoreCalculado        Float               @default(0)
  scoreBreakdown        Json?
  completudeDados       CompletudeDados     @default(PARCIAL)
  statusDecisao         StatusDecisaoOferta @default(GARIMPO)
  budgetTesteAlocado    Decimal?            @db.Decimal(10, 2)
  cpaAlvoBreakeven      Decimal?            @db.Decimal(10, 2)
  observacoes           String?             @db.Text

  // Governança — Rede, Revisão, Domínio, Termos, Descoberta
  networkId             String?
  network               Network?            @relation(fields: [networkId], references: [id], onDelete: SetNull)
  nextReviewAt          DateTime?
  domainUsed            String?
  termsVerifiedAt       DateTime?
  discoverySource       String?

  conversionPoint       ConversionPoint?
  tipoProduto           TipoProdutoAfiliado?
  ltvEstimadoRebill     Decimal?            @db.Decimal(10, 2)
  saturacaoAfiliados    SaturacaoAfiliados?
  criterioPausa         String?             @db.Text
  criterioEscala        String?             @db.Text

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  decisoes              DecisionLogOferta[]
  produtosGerados       ProdutoAfiliado[]
  domainLogs            DomainUsageLog[]
  termsVersions         TermsVersion[]
  termos                Termo[]

  @@index([nextReviewAt])
}

model Network {
  id                     String          @id @default(cuid())
  nome                   String          @unique
  paymentReliabilityScore Int?
  reliabilityUpdatedAt   DateTime?
  prazoPagamentoDias     Int?
  notas                  String?         @db.Text
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  ofertas                OfertaDecisao[]
}

model DomainUsageLog {
  id               String           @id @default(cuid())
  ofertaId         String
  oferta           OfertaDecisao    @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  domain           String
  usedFrom         DateTime
  usedUntil        DateTime?
  reputationStatus ReputationStatus @default(ok)
  createdAt        DateTime         @default(now())

  @@index([ofertaId, usedUntil])
}

model TermsVersion {
  id             String        @id @default(cuid())
  ofertaId       String
  oferta         OfertaDecisao @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  verifiedAt     DateTime
  termsUrl       String?
  changesSummary String?       @db.Text
  capturedBy     String?
  createdAt      DateTime      @default(now())

  @@index([ofertaId, verifiedAt])
}

model PortfolioConfig {
  id                    String        @id @default("default")
  totalAvailableCapital Decimal       @db.Decimal(14, 2)
  currency              String        @default("USD")
  // Fôlego financeiro de re-teste (afiliados-regras-teste-escala) — estado do
  // portfólio, promoção manual e direta, sem item de fila (ticket 08).
  perfilFolego          PerfilFolego  @default(INICIAL)
  updatedAt             DateTime      @updatedAt
}

enum PerfilFolego {
  INICIAL
  CAIXA_FORMADO
}

model DecisionLogOferta {
  id              String               @id @default(cuid())
  ofertaId        String
  oferta          OfertaDecisao        @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  statusAnterior  StatusDecisaoOferta?
  statusNovo      StatusDecisaoOferta
  justificativa   String               @db.Text
  autor           String?
  createdAt       DateTime             @default(now())
}

// ─── CAMPANHA / SNAPSHOT / ORÇAMENTO ─────────────────────────────────────────

model Campanha {
  id                    String              @id @default(cuid())
  produtoId             String
  produto               ProdutoAfiliado     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  contaTrafegoId        String?
  contaTrafego          ContaTrafego?       @relation(fields: [contaTrafegoId], references: [id], onDelete: SetNull)
  nomeContaAds          String?
  nomeCampanhaGoogleAds String
  geo                   String?
  estrategia            EstrategiaCampanha?
  papelConta            PapelContaAds       @default(PRINCIPAL)
  dataInicio            DateTime?
  dataFim               DateTime?
  status                StatusOperacional   @default(TESTANDO)
  budgetDiarioDefinido  Decimal?            @db.Decimal(10, 2)
  budgetTesteAlocado    Decimal?            @db.Decimal(10, 2)
  linkPainelGoogleAds   String?
  dataUltimaAtualizacao DateTime?
  moeda                 String?

  // LP bridge — atributo da campanha, não entidade própria (campanha-ficha)
  linkBridge            String?
  tipoBridge            TipoBridge?
  bridgeObservacoes     String?             @db.Text
  motivoEncerramento    MotivoEncerramento?

  // Rollups próprios da campanha, calculados a partir de VendaAfiliado confirmada
  // (distintos do rollup de ProdutoAfiliado, que usa CampanhaSnapshot/Ads como referência)
  gastoTotalAcumulado        Decimal?       @db.Decimal(14, 2)
  receitaConfirmadaAcumulada Decimal?       @db.Decimal(14, 2)
  roiReal                    Decimal?       @db.Decimal(10, 4)
  cpaReal                    Decimal?       @db.Decimal(10, 2)

  // Re-teste com troca de conta (perfil CAIXA_FORMADO) — vínculo explícito à
  // tentativa anterior, para o teto de fôlego financeiro somar entre campanhas
  // ligadas em vez de resetar a cada nova conta (ticket 08).
  campanhaOrigemId      String?
  campanhaOrigem        Campanha?           @relation("CampanhaReteste", fields: [campanhaOrigemId], references: [id], onDelete: SetNull)
  retestes              Campanha[]          @relation("CampanhaReteste")

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  snapshots   CampanhaSnapshot[]
  vendas      VendaAfiliado[]
  segmentos   SegmentoCampanhaSnapshot[]
  ajustes     AjusteCampanha[]
  statusLogs  CampanhaStatusLog[]

  @@index([produtoId])
  @@index([campanhaOrigemId])
  @@index([produtoId, nomeCampanhaGoogleAds])
}

model CampanhaSnapshot {
  id                String   @id @default(cuid())
  campanhaId        String
  campanha          Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  dataSnapshot      DateTime @db.Date
  gasto             Decimal? @db.Decimal(14, 2)
  impressoes        Int?
  cliques           Int?
  ctr               Decimal? @db.Decimal(8, 4)
  conversoes        Decimal? @db.Decimal(10, 2)
  cvr               Decimal? @db.Decimal(8, 4)
  cpcMedio          Decimal? @db.Decimal(10, 4)
  cpaReal           Decimal? @db.Decimal(10, 2)
  receitaConfirmada Decimal? @db.Decimal(14, 2) // reportado pelo Ads — auditoria/referência, não decide mais ROI
  roiReal           Decimal? @db.Decimal(10, 4)
  checkoutsCount    Int?     // acumulado do dia; três estados: real/manual/não coletado (null)
  createdAt         DateTime @default(now())
  // @default(now()) além de @updatedAt: campo novo numa tabela com linhas
  // existentes — sem default, `prisma db push` recusa a coluna NOT NULL em
  // produção (visto no deploy; SQL manual já cobria isso com DEFAULT CURRENT_TIMESTAMP).
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([campanhaId, dataSnapshot])
  @@index([campanhaId, dataSnapshot])
}

model OrcamentoPeriodo {
  id                     String   @id @default(cuid())
  periodo                String   @unique
  capitalTotalDisponivel Decimal  @db.Decimal(14, 2)
  moedaBase              String   @default("USD")
  limitePctPorProduto    Decimal? @db.Decimal(5, 2)
  reservaMinimaPct       Decimal  @default(0) @db.Decimal(5, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ─── CICLO DE TESTE E ESCALA ──────────────────────────────────────────────────
// Fecha o ciclo ingestão → teste → escala: contrato de ingestão agnóstico de
// fonte, VendaAfiliado como fonte de verdade de ROI, fila de decisão codificada
// e regras de teste/re-teste/escala/segmento sobre LimiarGlobal.
// Ver openspec/changes/afiliados-ciclo-teste-escala/design.md.

enum TipoIngestao {
  CAMPANHA_DIARIO
  SEGMENTO
  SERIE_TERMO
}

enum StatusColeta {
  SUCESSO
  FALHA
}

enum DimensaoSegmento {
  GEO
  DISPOSITIVO
}

enum TipoBridge {
  TSL
  VSL
  ADVERTORIAL
  QUIZ
  REVIEW
  DIRECT_LINK
  OUTRO
}

enum MotivoEncerramento {
  FALHA_EXECUCAO
  FALHA_MERCADO
}

enum TipoAlvoFila {
  OFERTA
  CAMPANHA
}

enum StatusItemFila {
  ABERTO
  ADIADO
  APLICADO
  DISPENSADO
  EXPIRADO
}

enum PrioridadeFila {
  ALTA
  MEDIA
  BAIXA
}

enum OrigemAjuste {
  FILA
  MANUAL
}

enum TipoAjuste {
  BUDGET
  CPA_ALVO
  LANCE_SEGMENTO
}

enum StatusUploadAds {
  PENDENTE
  ENVIADA
  FORA_DA_JANELA
  EXCLUIDA_REDE_NATIVA
  /// Venda enviada que foi retratada (ESTORNADA pós-envio) — distinto de
  /// ENVIADA para não reemitir a mesma RETRACTION a cada leitura do CSV
  /// (afiliados-conversao-offline; enum não previa este estado, adição
  /// aditiva desta implementação — sem drop de valores existentes).
  RETRATADA
}

enum FonteTermo {
  GOOGLE_KEYWORD_PLANNER
  BING
  GLIMPSE
  SEMRUSH
  FLOWSPY
  MANUAL
}

enum UnidadeSerieTermo {
  ABSOLUTO
  IMPRESSOES
  INDICE_0_100
}

// Bandeja de linhas do envelope de ingestão que não casaram com nenhuma Campanha
// por (googleAdsCustomerId, nomeCampanhaGoogleAds). Nada é descartado — só retido
// até reconciliação manual na UI (afiliados-ingestao).
model CampanhaNaoReconciliada {
  id                    String       @id @default(cuid())
  fonte                 String
  tipo                  TipoIngestao
  googleAdsCustomerId   String?
  nomeCampanhaGoogleAds String?
  linhaBruta            Json
  createdAt             DateTime     @default(now())
  resolvidoEm           DateTime?
  resolvidoCampanhaId   String?

  @@index([resolvidoEm])
  @@index([fonte, tipo])
}

// Última execução (sucesso ou falha) de cada (fonte, tipo) do envelope de
// ingestão. Não há detecção de silêncio nesta fase — só o fato é gravado.
model RegistroColeta {
  id                   String        @id @default(cuid())
  fonte                String
  tipo                 TipoIngestao
  ultimaExecucaoEm     DateTime?
  ultimoPeriodoCoberto Json?
  ultimoStatus         StatusColeta?
  ultimoErro           String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([fonte, tipo])
}

// Constantes de decisão chave→JSON, com override por produto
// (ProdutoAfiliado.limiaresOverride). Nenhuma regra hardcoda esses valores.
model LimiarGlobal {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     Json
  descricao String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// "Decida agora" codificado. Referência polimórfica fraca (tipoAlvo/alvoId,
// sem FK — mesmo padrão do Estúdio de Vídeo). A condição de disparo é pura em
// runtime; só o ciclo de vida do item já gerado é persistido.
model ItemFila {
  id          String         @id @default(cuid())
  tipoAlvo    TipoAlvoFila
  alvoId      String
  regra       String         // identificador da regra geradora (ex.: teste.tetoComissao)
  prioridade  PrioridadeFila
  resumo      String         @db.Text
  evidencia   Json?          // ex.: checkoutsCount vs. gate mínimo no teto de teste
  status      StatusItemFila @default(ABERTO)
  resolvidoEm DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  ajustes AjusteCampanha[]

  @@index([regra, tipoAlvo, alvoId])
  @@index([status, prioridade])
}

// Snapshot marginal por eixo (GEO ou DISPOSITIVO), sem cruzamento entre os
// dois. Coleta diária e incondicional via envelope de ingestão (tipo=SEGMENTO).
model SegmentoCampanhaSnapshot {
  id         String           @id @default(cuid())
  campanhaId String
  campanha   Campanha         @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  dimensao   DimensaoSegmento
  valor      String           // ex.: "BR" (GEO) ou "MOBILE" (DISPOSITIVO, inclui os 7 valores crus)
  data       DateTime         @db.Date
  gasto      Decimal?         @db.Decimal(14, 2)
  cliques    Int?
  conversoes Decimal?         @db.Decimal(10, 2)
  cpaReal    Decimal?         @db.Decimal(10, 2)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([campanhaId, dimensao, valor, data])
  @@index([campanhaId, dimensao, data])
}

// Ajuste efetivamente aplicado a uma campanha — sempre por confirmação de
// ItemFila ou registro manual explícito, nunca inferido por diff de snapshot.
model AjusteCampanha {
  id            String       @id @default(cuid())
  campanhaId    String
  campanha      Campanha     @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  itemFilaId    String?
  itemFila      ItemFila?    @relation(fields: [itemFilaId], references: [id], onDelete: SetNull)
  origem        OrigemAjuste
  tipo          TipoAjuste
  valorAnterior Decimal?     @db.Decimal(14, 4)
  valorNovo     Decimal?     @db.Decimal(14, 4)
  data          DateTime     @default(now())
  motivo        String?      @db.Text
  createdAt     DateTime     @default(now())

  @@index([campanhaId, data])
  @@index([itemFilaId])
}

// Histórico de transições de Campanha.status — mesmo formato de
// DecisionLogOferta/PersonaStatusLog (status anterior + novo + timestamp).
model CampanhaStatusLog {
  id             String             @id @default(cuid())
  campanhaId     String
  campanha       Campanha           @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  statusAnterior StatusOperacional?
  statusNovo     StatusOperacional
  motivo         String?
  data           DateTime           @default(now())

  @@index([campanhaId, data])
}

// Termo de busca acompanhado para um candidato (OfertaDecisao) ou produto já
// convertido (ProdutoAfiliado) — nunca os dois, nunca Campanha. A exclusividade
// é reforçada em Zod/aplicação (Prisma não expressa XOR de FK nativamente).
model Termo {
  id              String           @id @default(cuid())
  termo           String
  produtoId       String?
  produto         ProdutoAfiliado? @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  ofertaDecisaoId String?
  ofertaDecisao   OfertaDecisao?   @relation(fields: [ofertaDecisaoId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  series SerieTermo[]

  @@index([produtoId])
  @@index([ofertaDecisaoId])
}

// Série temporal de demanda de busca. Três estados via ausência-de-linha +
// valor nullable: não coletado (sem linha) / sem dado (valor=null) / zero
// confirmado (valor=0).
model SerieTermo {
  id        String            @id @default(cuid())
  termoId   String
  termo     Termo             @relation(fields: [termoId], references: [id], onDelete: Cascade)
  geo       String
  fonte     FonteTermo
  data      DateTime          @db.Date
  valor     Decimal?          @db.Decimal(14, 4)
  unidade   UnidadeSerieTermo
  origem    String            @default("manual") // manual | automatizado
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([termoId, geo, fonte, data])
  @@index([termoId, geo, data])
}

